+    chunk_indices: torch.Tensor | None = None,
+    use_qk_l2norm_in_kernel: bool = True,
+    core_attn_out: torch.Tensor | None = None,
+):
+    """Run FLA 0.5.1's fused GDN intra-chunk prefill kernel.
+
+    Qwen3.5/3.6 keeps recurrent state in [N, H, V, K] order, hence
+    state_v_first=True. vLLM precomputes chunk_indices in its metadata builder;
+    reusing them avoids a GPU-to-CPU synchronization in every GDN layer.
+    """
